#!/usr/bin/env python3
from __future__ import annotations

import argparse
import ast
import io
import re
import subprocess
import sys
import tempfile
import tokenize
from pathlib import Path

SENTINEL = "\x00"
SHELL_NAMES = ("sh", "bash", "zsh")
KINDS = ("python", "shell", "js", "css", "html")
REGEX_KEYWORDS = frozenset(
    {"return", "typeof", "instanceof", "in", "of", "new", "delete", "void", "throw", "case", "do", "else", "yield", "await"}
)
JS_WORD = re.compile(r"[A-Za-z0-9_$\u0080-￿]+")
ENCODING_LINE = re.compile(r"^[ \t\f]*#.*?coding[:=][ \t]*[-\w.]+")
SPECIAL_HTML = re.compile(r"<!--|<(script|style)\b[^>]*>", re.IGNORECASE)
SCRIPT_TYPE = re.compile(r"""\btype\s*=\s*["']?([^"'\s>]+)""", re.IGNORECASE)
JS_SCRIPT_TYPES = frozenset({"module", "text/javascript", "application/javascript"})
HTML_TAG = re.compile(r"""<\s*(/?)([A-Za-z][\w:-]*)((?:"[^"]*"|'[^']*'|[^>"'])*)>""")
VOID_TAGS = frozenset(
    {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source", "track", "wbr", "param"}
)
OPTIONAL_END_TAGS = frozenset(
    {"p", "li", "dt", "dd", "tr", "td", "th", "option", "thead", "tbody", "tfoot", "colgroup", "html", "head", "body"}
)


class Refused(Exception):
    pass


def kind_of(name: str, text: str) -> str | None:
    path = Path(name)
    if name.endswith((".html", ".html.in")):
        return "html"
    match path.suffix:
        case ".py":
            return "python"
        case ".sh":
            return "shell"
        case ".js":
            return "js"
        case ".css":
            return "css"
    if path.suffix or not text.startswith("#!"):
        return None
    words = text.split("\n", 1)[0][2:].split()
    if words and Path(words[0]).name == "env":
        words = [word for word in words[1:] if not word.startswith("-")]
    if words and Path(words[0]).name in SHELL_NAMES:
        return "shell"
    return None


def reject_sentinel(text: str) -> None:
    if SENTINEL in text:
        raise Refused("holds a NUL character")


def split_ending(line: str) -> tuple[str, str]:
    body = line.rstrip("\r\n")
    return body, line[len(body) :]


def settle_removals(text: str) -> str:
    result: list[str] = []
    for line in text.split("\n"):
        if SENTINEL not in line:
            result.append(line)
            continue
        carriage = "\r" if line.endswith("\r") else ""
        line = line.removesuffix("\r")
        if line.replace(SENTINEL, "").strip() == "":
            continue
        pieces = line.split(SENTINEL)
        merged = pieces[0]
        for piece in pieces[1:]:
            if merged and piece and not merged[-1].isspace() and not piece[0].isspace():
                merged += " "
            elif merged[-1:].isspace():
                piece = piece.lstrip(" \t")
            merged += piece
        result.append(merged.rstrip(" \t") + carriage if pieces[-1] == "" else merged + carriage)
    return "\n".join(result)


def find_protected_rows(lines: list[str]) -> set[int]:
    rows: set[int] = set()
    if lines and lines[0].startswith("#!"):
        rows.add(1)
    for row in (1, 2):
        if row <= len(lines) and ENCODING_LINE.match(lines[row - 1]):
            rows.add(row)
    block_start = None
    for row, line in enumerate(lines, 1):
        body = line.rstrip("\r\n")
        if block_start is None and body == "# /// script":
            block_start = row
        elif block_start is not None and body == "# ///":
            rows.update(range(block_start, row + 1))
            block_start = None
    return rows


def to_char_column(line: str, byte_column: int) -> int:
    return len(line.encode()[:byte_column].decode())


def reject_doc_reads(tree: ast.AST) -> None:
    for node in ast.walk(tree):
        if isinstance(node, ast.Name) and node.id == "__doc__":
            raise Refused("reads __doc__")
        if isinstance(node, ast.Attribute) and node.attr == "__doc__":
            raise Refused("reads __doc__")


def find_docstrings(tree: ast.Module) -> list[tuple[ast.Expr, bool, bool]]:
    found = []
    for node in ast.walk(tree):
        if not isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):
            continue
        first = node.body[0] if node.body else None
        if (
            isinstance(first, ast.Expr)
            and isinstance(first.value, ast.Constant)
            and isinstance(first.value.value, str)
        ):
            found.append((first, len(node.body) == 1, isinstance(node, ast.Module)))
    return found


def strip_python(text: str) -> str:
    tree = ast.parse(text)
    reject_doc_reads(tree)
    original = io.StringIO(text, newline="").readlines()
    current = list(original)
    protected = find_protected_rows(original)
    touched: set[int] = set()
    dropped: set[int] = set()

    for token in tokenize.generate_tokens(io.StringIO(text, newline="").readline):
        if token.type != tokenize.COMMENT or token.start[0] in protected:
            continue
        row, column = token.start
        body, ending = split_ending(current[row - 1])
        current[row - 1] = body[:column].rstrip(" \t") + ending
        touched.add(row - 1)

    for statement, is_sole, is_module in find_docstrings(tree):
        first_row = statement.lineno - 1
        last_row = statement.end_lineno - 1
        start = to_char_column(original[first_row], statement.col_offset)
        stop = to_char_column(original[last_row], statement.end_col_offset)
        prefix = current[first_row][:start]
        suffix = current[last_row][stop:]
        covers_lines = prefix.strip() == "" and suffix.strip() == ""
        rows = range(first_row + 1, last_row + 1)
        if covers_lines and is_module:
            dropped.update(range(first_row, last_row + 1))
        elif covers_lines and is_sole:
            current[first_row] = prefix + "..." + split_ending(suffix)[1]
            dropped.update(rows)
        elif covers_lines:
            dropped.update(range(first_row, last_row + 1))
        else:
            current[first_row] = prefix + "..." + suffix
            dropped.update(rows)

    kept = []
    for row, line in enumerate(current):
        if row in dropped:
            continue
        if row in touched and line.strip() == "" and original[row].strip() != "":
            continue
        kept.append(line)
    return "".join(kept)


class ShellLexer:
    def __init__(self, text: str) -> None:
        self.text = text
        self.position = 0
        self.out: list[str] = []
        self.pending: list[tuple[str, bool]] = []

    def run(self) -> str:
        text = self.text
        if text.startswith("#!"):
            end = text.find("\n")
            end = len(text) if end < 0 else end
            self.out.append(text[:end])
            self.position = end
        self.lex_code(None)
        return settle_removals("".join(self.out))

    def take(self, count: int) -> None:
        self.out.append(self.text[self.position : self.position + count])
        self.position += count

    def lex_code(self, closer: str | None) -> None:
        text = self.text
        depth = 0
        while self.position < len(text):
            char = text[self.position]
            before = text[self.position - 1] if self.position else "\n"
            if char == "\n":
                self.take(1)
                if self.pending:
                    self.read_heredocs()
            elif char == "#" and before in " \t\n;&|()":
                end = text.find("\n", self.position)
                self.out.append(SENTINEL)
                self.position = len(text) if end < 0 else end
            elif char == "\\":
                self.take(2)
            elif char == "'":
                self.scan_single()
            elif char == '"':
                self.lex_double()
            elif char == "$":
                self.lex_dollar(in_double=False)
            elif char == "`":
                self.scan_backtick()
            elif text.startswith("((", self.position):
                self.scan_arithmetic()
            elif char == "<" and text.startswith("<<", self.position) and not text.startswith("<<<", self.position):
                self.read_heredoc_header()
            elif char == "(":
                depth += 1
                self.take(1)
            elif char == ")":
                self.take(1)
                if closer == ")" and depth == 0:
                    return
                depth = max(depth - 1, 0)
            else:
                self.take(1)

    def scan_single(self) -> None:
        end = self.text.find("'", self.position + 1)
        if end < 0:
            raise Refused("unterminated single quote")
        self.take(end + 1 - self.position)

    def scan_backtick(self) -> None:
        index = self.position + 1
        while index < len(self.text) and self.text[index] != "`":
            index += 2 if self.text[index] == "\\" else 1
        if index >= len(self.text):
            raise Refused("unterminated backtick")
        self.take(index + 1 - self.position)

    def scan_arithmetic(self) -> None:
        index = self.position
        depth = 0
        while index < len(self.text):
            char = self.text[index]
            if char == "(":
                depth += 1
            elif char == ")":
                depth -= 1
                if depth == 0:
                    break
            index += 1
        if index >= len(self.text):
            raise Refused("unterminated arithmetic")
        self.take(index + 1 - self.position)

    def lex_double(self) -> None:
        text = self.text
        self.take(1)
        while self.position < len(text):
            char = text[self.position]
            if char == "\\":
                self.take(2)
            elif char == '"':
                self.take(1)
                return
            elif char == "$":
                self.lex_dollar(in_double=True)
            elif char == "`":
                self.scan_backtick()
            else:
                self.take(1)
        raise Refused("unterminated double quote")

    def lex_dollar(self, *, in_double: bool) -> None:
        text = self.text
        following = text[self.position + 1 : self.position + 2]
        if following == "'" and not in_double:
            index = self.position + 2
            while index < len(text) and text[index] != "'":
                index += 2 if text[index] == "\\" else 1
            self.take(index + 1 - self.position)
        elif following == "(" and text.startswith("$((", self.position):
            self.take(1)
            self.scan_arithmetic()
        elif following == "(":
            self.take(2)
            self.lex_code(")")
        elif following == "{":
            self.take(2)
            self.scan_brace(in_double=in_double)
        else:
            self.take(2 if following else 1)

    def scan_brace(self, *, in_double: bool) -> None:
        text = self.text
        depth = 1
        while self.position < len(text):
            char = text[self.position]
            if char == "\\":
                self.take(2)
            elif char == "'" and not in_double:
                self.scan_single()
            elif char == '"':
                self.lex_double()
            elif char == "$":
                self.lex_dollar(in_double=in_double)
            elif char == "{":
                depth += 1
                self.take(1)
            elif char == "}":
                depth -= 1
                self.take(1)
                if depth == 0:
                    return
            else:
                self.take(1)
        raise Refused("unterminated parameter expansion")

    def read_heredoc_header(self) -> None:
        text = self.text
        self.take(2)
        strips_tabs = text.startswith("-", self.position)
        if strips_tabs:
            self.take(1)
        while text[self.position : self.position + 1] in (" ", "\t"):
            self.take(1)
        start = self.position
        delimiter = ""
        while self.position < len(text) and text[self.position] not in " \t\n;&|()<>":
            char = text[self.position]
            if char in "'\"":
                end = text.find(char, self.position + 1)
                if end < 0:
                    raise Refused("unterminated heredoc delimiter")
                delimiter += text[self.position + 1 : end]
                self.take(end + 1 - self.position)
            elif char == "\\":
                delimiter += text[self.position + 1 : self.position + 2]
                self.take(2)
            else:
                delimiter += char
                self.take(1)
        if self.position == start:
            raise Refused("heredoc without delimiter")
        self.pending.append((delimiter, strips_tabs))

    def read_heredocs(self) -> None:
        text = self.text
        for delimiter, strips_tabs in self.pending:
            while self.position < len(text):
                end = text.find("\n", self.position)
                end = len(text) if end < 0 else end + 1
                line = text[self.position : end]
                self.take(end - self.position)
                body = line.rstrip("\n")
                if (body.lstrip("\t") if strips_tabs else body) == delimiter:
                    break
        self.pending = []


def strip_shell(text: str) -> str:
    reject_sentinel(text)
    return ShellLexer(text).run()


def scan_quoted(text: str, start: int) -> int:
    quote = text[start]
    index = start + 1
    while index < len(text):
        char = text[index]
        if char == "\\":
            index += 2
        elif char == quote:
            return index + 1
        elif char == "\n":
            break
        else:
            index += 1
    raise Refused("unterminated string")


def scan_regex(text: str, start: int) -> int:
    index = start + 1
    in_class = False
    while index < len(text):
        char = text[index]
        if char == "\\":
            index += 2
            continue
        if char == "\n":
            break
        if char == "[":
            in_class = True
        elif char == "]":
            in_class = False
        elif char == "/" and not in_class:
            index += 1
            while index < len(text) and text[index].isalnum():
                index += 1
            return index
        index += 1
    raise Refused("unterminated regular expression")


def scan_template(text: str, start: int, out: list[str]) -> tuple[int, bool]:
    index = start
    while index < len(text):
        if text[index] == "\\":
            index += 2
        elif text[index] == "`":
            out.append(text[start : index + 1])
            return index + 1, False
        elif text.startswith("${", index):
            out.append(text[start : index + 2])
            return index + 2, True
        else:
            index += 1
    raise Refused("unterminated template literal")


def strip_js(text: str, *, is_file: bool = True) -> str:
    reject_sentinel(text)
    out: list[str] = []
    index = 0
    depth = 0
    saved_depths: list[int] = []
    regex_allowed = True
    if is_file and text.startswith("#!"):
        end = text.find("\n")
        end = len(text) if end < 0 else end
        out.append(text[:end])
        index = end
    while index < len(text):
        char = text[index]
        pair = text[index : index + 2]
        if char.isspace():
            out.append(char)
            index += 1
        elif pair == "//":
            end = text.find("\n", index)
            out.append(SENTINEL)
            index = len(text) if end < 0 else end
        elif pair == "/*":
            end = text.find("*/", index + 2)
            if end < 0:
                raise Refused("unterminated block comment")
            out.append(SENTINEL)
            index = end + 2
        elif char == "/" and regex_allowed:
            end = scan_regex(text, index)
            out.append(text[index:end])
            index = end
            regex_allowed = False
        elif char in "'\"":
            end = scan_quoted(text, index)
            out.append(text[index:end])
            index = end
            regex_allowed = False
        elif char == "`":
            out.append("`")
            index, entered = scan_template(text, index + 1, out)
            if entered:
                saved_depths.append(depth)
                depth = 0
            regex_allowed = entered
        elif char == "}" and depth == 0 and saved_depths:
            depth = saved_depths.pop()
            out.append("}")
            index, entered = scan_template(text, index + 1, out)
            if entered:
                saved_depths.append(depth)
                depth = 0
            regex_allowed = entered
        else:
            word = JS_WORD.match(text, index)
            if word:
                out.append(word.group())
                index = word.end()
                regex_allowed = word.group() in REGEX_KEYWORDS
                continue
            if char == "{":
                depth += 1
            elif char == "}":
                depth = max(depth - 1, 0)
            out.append(char)
            index += 1
            regex_allowed = char not in ")]}"
    return settle_removals("".join(out))


def strip_css(text: str) -> str:
    reject_sentinel(text)
    out: list[str] = []
    index = 0
    while index < len(text):
        char = text[index]
        if text.startswith("/*", index):
            end = text.find("*/", index + 2)
            if end < 0:
                raise Refused("unterminated block comment")
            out.append(SENTINEL)
            index = end + 2
        elif char in "'\"":
            end = scan_quoted(text, index)
            out.append(text[index:end])
            index = end
        else:
            out.append(char)
            index += 1
    return settle_removals("".join(out))


def strip_embedded(tag: str, opening: str, body: str) -> str:
    if tag == "style":
        return strip_css(body)
    declared = SCRIPT_TYPE.search(opening)
    if declared and declared.group(1).lower() not in JS_SCRIPT_TYPES:
        return body
    return strip_js(body, is_file=False)


def strip_html(text: str) -> str:
    reject_sentinel(text)
    out: list[str] = []
    index = 0
    while True:
        found = SPECIAL_HTML.search(text, index)
        if not found:
            out.append(text[index:])
            break
        out.append(text[index : found.start()])
        if found.group(0) == "<!--":
            end = text.find("-->", found.end())
            if end < 0:
                raise Refused("unterminated HTML comment")
            out.append(SENTINEL)
            index = end + 3
            continue
        tag = found.group(1).lower()
        out.append(found.group(0))
        closing = re.compile(r"</" + tag, re.IGNORECASE).search(text, found.end())
        stop = closing.start() if closing else len(text)
        out.append(strip_embedded(tag, found.group(0), text[found.end() : stop]))
        index = stop
    return settle_removals("".join(out))


def strip_text(kind: str, text: str) -> str:
    match kind:
        case "python":
            return strip_python(text)
        case "shell":
            return strip_shell(text)
        case "js":
            return strip_js(text)
        case "css":
            return strip_css(text)
        case "html":
            return strip_html(text)
    raise ValueError(kind)


def css_balance_errors(text: str) -> list[str]:
    pairs = {"}": "{", ")": "(", "]": "["}
    stack: list[str] = []
    index = 0
    while index < len(text):
        char = text[index]
        if text.startswith("/*", index):
            end = text.find("*/", index + 2)
            index = len(text) if end < 0 else end + 2
            continue
        if char in "'\"":
            try:
                index = scan_quoted(text, index)
            except Refused:
                return ["unterminated string"]
            continue
        if char in "{([":
            stack.append(char)
        elif char in pairs:
            if not stack or stack.pop() != pairs[char]:
                return [f"unbalanced {char!r}"]
        index += 1
    return [f"unclosed {stack[-1]!r}"] if stack else []


def html_balance_errors(text: str) -> list[str]:
    plain = re.sub(r"<!--.*?-->", "", text, flags=re.DOTALL)
    plain = re.sub(r"(<(script|style)\b[^>]*>).*?(</\2\s*>)", r"\1\3", plain, flags=re.DOTALL | re.IGNORECASE)
    stack: list[str] = []
    for match in HTML_TAG.finditer(plain):
        closing, name, rest = match.group(1), match.group(2).lower(), match.group(3)
        if name in VOID_TAGS or rest.rstrip().endswith("/"):
            continue
        if not closing:
            stack.append(name)
            continue
        if name not in stack:
            return [f"stray </{name}>"]
        while stack[-1] != name:
            if stack.pop() not in OPTIONAL_END_TAGS:
                return [f"</{name}> closes over an open <{stack[-1]}>"]
        stack.pop()
    unclosed = [name for name in stack if name not in OPTIONAL_END_TAGS]
    return [f"unclosed <{unclosed[-1]}>"] if unclosed else []


def run_checker(command: list[str], text: str | None = None) -> list[str]:
    try:
        done = subprocess.run(command, input=text, capture_output=True, text=True)
    except FileNotFoundError:
        return []
    if not done.returncode:
        return []
    lines = done.stderr.strip().splitlines()
    return [lines[-1] if lines else "parse failed"]


def syntax_errors(kind: str, text: str, name: str) -> list[str]:
    match kind:
        case "python":
            try:
                compile(text, name, "exec")
            except SyntaxError as error:
                return [str(error)]
            return []
        case "shell":
            return run_checker(["bash", "-n"], text)
        case "js":
            with tempfile.TemporaryDirectory() as folder:
                target = Path(folder) / "check.mjs"
                target.write_text(text)
                return run_checker(["node", "--check", str(target)])
        case "css":
            return css_balance_errors(text)
        case "html":
            return html_balance_errors(text)
    raise ValueError(kind)


def parse_arguments(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="strip-comments")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--syntax", action="store_true")
    parser.add_argument("--stdin", metavar="NAME")
    parser.add_argument("files", nargs="*")
    return parser.parse_args(argv)


def handle_text(arguments: argparse.Namespace, name: str, text: str) -> tuple[int, str | None]:
    kind = kind_of(name, text)
    if kind is None:
        return 0, None
    if arguments.syntax:
        errors = syntax_errors(kind, text, name)
        for error in errors:
            print(f"{name}: {error}")
        return (1 if errors else 0), None
    try:
        stripped = strip_text(kind, text)
    except (Refused, SyntaxError, tokenize.TokenError, UnicodeDecodeError) as error:
        print(f"{name}: {error}", file=sys.stderr)
        return 2, None
    if arguments.check:
        if stripped != text:
            print(name)
            return 1, None
        return 0, None
    return 0, stripped


def main(argv: list[str]) -> int:
    arguments = parse_arguments(argv)
    worst = 0
    if arguments.stdin is not None:
        text = sys.stdin.buffer.read().decode()
        code, stripped = handle_text(arguments, arguments.stdin, text)
        if code == 0 and not arguments.check and not arguments.syntax:
            sys.stdout.buffer.write((text if stripped is None else stripped).encode())
        return code
    for name in arguments.files:
        path = Path(name)
        try:
            text = path.read_bytes().decode()
        except (OSError, UnicodeDecodeError) as error:
            print(f"{name}: {error}", file=sys.stderr)
            worst = max(worst, 2)
            continue
        code, stripped = handle_text(arguments, name, text)
        worst = max(worst, code)
        if stripped is not None and stripped != text:
            path.write_bytes(stripped.encode())
    return worst


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
