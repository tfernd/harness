def render_real_costs(data: dict) -> str:
    """Logged cost per call and per long session by model, and compactions per session, for comparing two windows."""
    real = data["real_costs"]
    rows = [
        [
            model,
            f"{e['calls']:,.0f}",
            fmt_money(e["cost"]),
            f"${e['cost_per_call']:.4f}",
            f"{e['sessions']:,.0f}",
            f"{e['long_sessions']:,.0f}",
            fmt_money(e["cost_per_long_session"]),
        ]
        for model, e in sorted(real["by_model"].items())
    ]
    out = [
        "<h2>Real cost in this window</h2>",
        "<p>As logged, no replay. Compare two runs with different --since and --until to see the effect of a changed setting.</p>",
    ]
    out.append(table(["model", "calls", "cost", "cost per call", "sessions", "long sessions", "cost per long session"], rows))
    kinds = []
    for kind, label in LABELS.items():
        group = [row for row in real["sessions"] if row["kind"] == kind]
        if group:
            counts = [row["compactions"] for row in group]
            kinds.append(
                [
                    label,
                    f"{len(group):,}",
                    f"{sum(counts):,}",
                    f"{sum(1 for c in counts if c):,}",
                    f"{statistics.fmean(counts):.2f}",
                    f"{max(counts):,}",
                ]
            )
    out.append(
        table(
            ["group", "sessions", "compactions", "sessions with a compaction", "mean per session", "most in one session"], kinds
        )
    )
    return "".join(out)


def render_page(data: dict) -> str:
    """The whole self-contained report page."""
    window = data["window"]
    span = f"from {window['since'] or 'the first call'} to {window['until'] or 'the last call'}"
    prices = []
    for model, p in data["pricing"].items():
        b, tier = p["base"], p["long"]
        extra = (
            f"; above {fmt_tokens(p['long_above'])} prompt tokens: input ${tier['inp']:g}, output ${tier['out']:g}, cache read ${tier['read']:g}"
            if tier
            else ""
        )
        prices.append(
            f"<li><code>{html.escape(model)}</code>: input ${b['inp']:g}, output ${b['out']:g}, cache read ${b['read']:g}, cache write ${b['write5m']:g} (5 min) / ${b['write1h']:g} (1 hour){extra}</li>"
        )
    excluded = (
        f"{data['excluded_sessions']:,} sessions use models without a price ({', '.join(html.escape(m) for m in data['excluded_models'])}) and are excluded."
        if data["excluded_sessions"]
        else "Every session's model has a price; none was excluded."
    )
    limits = [
        "Compaction loses information. Work redone after a compaction (re-reading files, repeated steps) is not priced, so lower thresholds look cheaper than they are.",
        "Cache misses from expired cache are kept only as observed: each call keeps the share of its previous context that was not read from cache, applied to the simulated context.",
        "The log has no line for the compaction call itself, so its cost is modelled: it reads the context before and writes a summary of the median size as output.",
        "Context growth per call is taken from the observed sequence. The jump of a real compaction is replaced by the new tokens of that call; an unmarked context drop uses the logged values of that call.",
        "The replay check is close to circular: in the real-compaction mode the growth, cache-miss share and post-compaction size all come from the same log, so a small error shows the bookkeeping is consistent, not that the threshold model predicts anything.",
        "Prices are list prices and go stale. On a subscription this shows relative cost, not a bill.",
        "Sub-agent runs are replayed with their own contexts and reported apart; their numbers are not added to the main sessions.",
        "A replayed session keeps its observed calls; a lower threshold does not change how many calls the work needed.",
    ]
    sections = "".join(
        render_section(data, kind, title)
        for kind, title in (("main", "Main sessions"), ("sub", "Sub-agents (own contexts, reported apart)"))
        if data["sets"][kind]["num_sessions"]
    )
    main, sub = data["sets"]["main"], data["sets"]["sub"]
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Auto-compaction threshold: what it costs</title><style>{CSS}</style></head><body>
<h1>Auto-compaction threshold: what it costs</h1>
<p class="note">Generated {data["generated"]}. Window: {span} (calls filtered by timestamp). The plan for the settings change is in the compaction settings plan, <a href="compaction-settings.md">compaction-settings.md</a>.</p>
<div class="rec"><h2 style="border:0;margin:.5rem 0 0">Recommendation</h2><p>{pick_recommendation(data)}</p>
<p><small>Uncertainty: the interval comes from resampling sessions, not from rework or cache behaviour the replay cannot see (see the limits below). The replay check is
{fmt_percent(data["sets"][data["primary"]]["check"]["percent_error"])} off the logged cost.</small></p></div>
{render_curves(data)}
{render_real_costs(data)}
<h2>What was measured</h2>
<p>Real compactions seen: {main["compactions"]["count"]:,} in main sessions and {sub["compactions"]["count"]:,} in sub-agents. The replay summary size is the observed median context after a compaction, {data["summary_tokens"]:,} tokens.</p>
{render_measurements(data)}
<h2>How the replay works</h2>
<p>For each session, context per call is uncached input plus cache read plus cache write. Each call adds the new tokens seen in the observed sequence. When the replayed context reaches the threshold T, one compaction call is charged
(cache read of the context, output of the summary) and the context restarts from the summary; the next call writes it to the cache. Between compactions a call pays cache read on the existing context, cache write on its new tokens, and the logged output.
"actual" is the logged calls plus the modelled cost of the real compactions, so every column contains the same kind of compaction charge. "never" is the same replay with no compaction at all.</p>
<h3>Prices</h3><p>Source: {html.escape(data["prices_source"])}; list prices per million tokens, which go stale. {excluded}</p><ul>{"".join(prices)}</ul>
<h3>What the model leaves out</h3><ul>{"".join(f"<li>{html.escape(item)}</li>" for item in limits)}</ul>
{sections}
</body></html>
"""


# ===========================================================================
# Main
# ===========================================================================


def check_monotonic(data: dict) -> bool:
    """True when the number of compactions never rises as the threshold rises, in every group."""
    ok = True
    groups = {**data["sets"], **{f"model {name}": block for name, block in data["models"].items() if block["num_calls"]}}
    for kind, block in groups.items():
        counts = [block["thresholds"][str(t)]["cost"]["num_compactions"] for t in THRESHOLDS]
        rising = [(THRESHOLDS[i], THRESHOLDS[i + 1]) for i in range(len(counts) - 1) if counts[i] < counts[i + 1]]
        shown = {t: c for t, c in zip(THRESHOLDS, counts, strict=False) if t in CORE}
        print(f"{kind}: compactions {shown} none={block['thresholds']['none']['cost']['num_compactions']} rising_pairs={rising}")
        ok = ok and not rising
    return ok


def parse_day(text: str) -> str:
    """A YYYY-MM-DD day, validated; an empty text means no bound."""
    if not text:
        return text
    try:
        datetime.strptime(text, "%Y-%m-%d")
    except ValueError as error:
        raise argparse.ArgumentTypeError(f"{text!r} is not a YYYY-MM-DD day") from error
    return text


def run(args: argparse.Namespace) -> int:
    """Extract, replay and write the files; raises ToolError for a problem the user can fix."""
    prices = load_prices(args.prices)
    root = get_root(args.root)
    sessions = load_sessions(root, args.since, args.until)
    if not any(all(call.model in prices for call in session.calls) for session in sessions):
        raise ToolError("no session with a priced model and usable calls was found in the window")
    data = build_data(sessions, prices, builtin_prices=args.prices is None, window=(args.since, args.until))
    args.out.mkdir(parents=True, exist_ok=True)
    (args.out / "data.json").write_text(json.dumps(data, indent=1), encoding="utf-8")
    (args.out / "report.html").write_text(render_page(data), encoding="utf-8")
    for kind, block in data["sets"].items():
        if not block["num_sessions"]:
            continue
        check = block["check"]
        state = "OK" if abs(check["percent_error"]) <= check["tolerance"] else "OUTSIDE TOLERANCE"
        print(
            f"replay check {kind}: sessions={block['num_sessions']} calls={block['num_calls']} replay={check['replay_total']:.2f} "
            f"logged={check['observed_total']:.2f} error={check['percent_error']:+.2f}% (tolerance {check['tolerance']}%) {state}"
        )
    print("compactions fall as T rises:", check_monotonic(data))
    primary = data["sets"][data["primary"]]["curve"]
    print(
        f"minimum {primary['min_threshold']} ({primary['min_percent']:+.1f}%), robust {data['sensitivity']['robust_threshold']}"
    )
    print(f"wrote {args.out / 'report.html'} and {args.out / 'data.json'}")
    return 0


def main() -> int:
    """Parse the command line and run; a ToolError prints one line and exits 1."""
    parser = argparse.ArgumentParser(
        description="Cost of auto-compaction in Claude Code session logs, replayed at other thresholds."
    )
    parser.add_argument(
        "--root", type=Path, help="folder with the session logs (default: $CLAUDE_CONFIG_DIR/projects, else ~/.claude/projects)"
    )
    parser.add_argument(
        "--out",
        type=Path,
        default=Path("compaction-report"),
        help="folder for data.json and report.html (default: ./compaction-report)",
    )
    parser.add_argument("--prices", type=Path, help="JSON file of prices that overrides the built-in table")
    parser.add_argument("--since", type=parse_day, default="", help="first day to include, YYYY-MM-DD")
    parser.add_argument("--until", type=parse_day, default="", help="last day to include, YYYY-MM-DD")
    try:
        return run(parser.parse_args())
    except ToolError as error:
        print(f"compaction-report: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
