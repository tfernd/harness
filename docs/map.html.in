<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Harness</title>
  <meta name="description" content="What the harness plugin for Claude Code does: its agents, skills and hooks, and how hard each rule binds.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap">
  <script>
    try {
      const savedTheme = localStorage.getItem("harness-map-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (savedTheme === "dark" || (savedTheme === null && prefersDark)) document.documentElement.dataset.theme = "dark";
      const savedTarget = localStorage.getItem("harness-map-target");
      if (savedTarget === "cortex" || savedTarget === "kiro") document.documentElement.dataset.target = savedTarget;
    } catch (error) {
      console.warn("The saved theme or install target could not be read.", error);
    }
  </script>
  <link rel="stylesheet" href="style.css?v={{style_hash}}">
  <style>
    .wire {
      --wire-spawn: #1d4ed8;
      --wire-preload: #0f766e;
      --wire-inject: #7c3aed;
      --wire-check: #c2410c;
      --wire-point: #4b5563;
      --wire-main: #111827;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      min-inline-size: 0;
      padding: var(--space-4);
    }

    :root[data-theme="dark"] .wire {
      --wire-spawn: #8ab4ff;
      --wire-preload: #4fd8c4;
      --wire-inject: #c4a8ff;
      --wire-check: #ff9a6b;
      --wire-point: #b4bcc8;
      --wire-main: #eef1f5;
    }

    .wire-title {
      font-size: var(--text-panel);
      font-weight: 700;
    }

    .wire-intro {
      max-inline-size: var(--measure);
      font-size: var(--text-body);
    }

    .wire-legend {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .wire-toggle {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-block-size: var(--chip-height-touch);
      padding-inline: var(--space-3);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-pill);
      background: var(--surface);
      color: var(--ink);
      font: inherit;
      font-size: var(--text-chip);
      cursor: pointer;
    }

    .wire-toggle:hover {
      background: var(--surface-soft);
    }

    .wire-toggle[aria-pressed="true"] {
      border-color: var(--ink);
      background: var(--surface-soft);
      font-weight: 600;
    }

    .wire-toggle[aria-pressed="false"] .wire-swatch {
      opacity: var(--dim-level);
    }

    .wire-swatch {
      flex: none;
      inline-size: 2.5rem;
      block-size: 0.75rem;
    }

    .wire-status {
      min-block-size: 1.25rem;
      font-size: var(--text-body);
      color: var(--muted);
    }

    .wire-scroll {
      overflow-x: auto;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface-soft);
    }

    .wire-svg {
      display: block;
      inline-size: 100%;
      min-inline-size: 62rem;
      block-size: auto;
    }

    .wire-line {
      fill: none;
      stroke-linecap: round;
      transition: opacity var(--duration);
    }

    .wire-line.is-spawn {
      stroke: var(--wire-spawn);
      stroke-width: 3;
    }

    .wire-line.is-preload {
      stroke: var(--wire-preload);
      stroke-width: 2;
    }

    .wire-line.is-inject {
      stroke: var(--wire-inject);
      stroke-width: 2;
      stroke-dasharray: 8 5;
    }

    .wire-line.is-check {
      stroke: var(--wire-check);
      stroke-width: 2.25;
      stroke-dasharray: 1 5;
    }

    .wire-line.is-point {
      stroke: var(--wire-point);
      stroke-width: 1.75;
      stroke-dasharray: 3 3;
    }

    .wire-head {
      stroke: none;
    }

    .wire-head.is-spawn {
      fill: var(--wire-spawn);
    }

    .wire-head.is-preload {
      fill: var(--wire-preload);
    }

    .wire-head.is-inject {
      fill: var(--wire-inject);
    }

    .wire-head.is-check {
      fill: var(--wire-check);
    }

    .wire-head.is-point {
      fill: var(--wire-point);
    }

    .wire-edges .wire-line {
      opacity: 0.9;
    }

    .wire-edges .wire-line.is-off {
      display: none;
    }

    .wire-edges .wire-line.is-dim {
      opacity: 0.06;
    }

    .wire-edges .wire-line.is-linked {
      opacity: 1;
      stroke-width: 3.5;
    }

    .wire-node {
      cursor: pointer;
      transition: opacity var(--duration);
    }

    .wire-node rect {
      fill: var(--surface);
      stroke: var(--line-strong);
      stroke-width: 1.5;
    }

    .wire-node.is-hook rect {
      stroke: var(--kind-hook);
    }

    .wire-node.is-agent rect {
      stroke: var(--kind-agent);
    }

    .wire-node.is-skill rect {
      stroke: var(--kind-skill);
    }

    .wire-node.is-main rect {
      stroke: var(--wire-main);
      stroke-width: 2.5;
    }

    .wire-node:hover rect,
    .wire-node[aria-pressed="true"] rect {
      stroke-width: 3;
    }

    .wire-node:focus-visible {
      outline: none;
    }

    .wire-node:focus-visible rect {
      stroke: var(--focus);
      stroke-width: 3.5;
    }

    .wire-node.is-dim {
      opacity: var(--dim);
    }

    .wire-name {
      fill: var(--ink);
      font-size: 15px;
      font-weight: 700;
    }

    .wire-sub {
      fill: var(--muted);
      font-size: 12.5px;
    }

    .wire-skill {
      fill: var(--ink);
      font-size: 13px;
    }

    .wire-column {
      fill: var(--ink);
      font-size: 14px;
      font-weight: 700;
    }

    @media (prefers-reduced-motion: reduce) {
      .wire-line,
      .wire-node {
        transition: none;
      }
    }
  </style>
</head>
<body>
  <svg class="sprite" width="0" height="0" aria-hidden="true" focusable="false">
    <symbol id="i-model" viewBox="0 0 16 16"><path d="M4 4h8v8H4zM6.5 1.5v2.5M9.5 1.5v2.5M6.5 12v2.5M9.5 12v2.5M1.5 6.5H4M1.5 9.5H4M12 6.5h2.5M12 9.5h2.5"/></symbol>
    <symbol id="i-tools" viewBox="0 0 16 16"><path d="M10.5 2.5a3 3 0 0 0-3.2 4L2.5 11.3 4.7 13.5 9.5 8.7a3 3 0 0 0 4-3.2L11.7 7.3 9.7 6.3 8.7 4.3z"/></symbol>
    <symbol id="i-load" viewBox="0 0 16 16"><path d="M8 2v8M4.5 7 8 10.5 11.5 7M3 13h10"/></symbol>
    <symbol id="i-when" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6"/><path d="M8 7.5V11M8 5v.5"/></symbol>
    <symbol id="i-events" viewBox="0 0 16 16"><path d="M9 1.5 3.5 9H8l-1 5.5L12.5 7H8z"/></symbol>
    <symbol id="i-levels" viewBox="0 0 16 16"><path d="M2 13V9M6 13V6M10 13V3M14 13V1.5"/></symbol>
    <symbol id="i-ports" viewBox="0 0 16 16"><path d="M2 4h12M2 8h12M2 12h12"/></symbol>
    <symbol id="i-kind" viewBox="0 0 16 16"><path d="M2.5 2.5h6l5 5-6 6-5-5z"/></symbol>
  </svg>
  <div class="page">
    <header class="page-head">
      <div class="page-intro">
        <div class="page-title-row">
          <h1 class="page-title">Harness</h1>
          <button type="button" class="theme-switch" role="switch" aria-checked="false" data-theme-toggle>
            <span class="theme-switch-track" aria-hidden="true"><span class="theme-switch-thumb"></span></span>
            <span class="theme-switch-label">Dark</span>
          </button>
          <a class="band-link" href="band.html">
            <span class="band-link-dot" aria-hidden="true"></span>
            See the agent band
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <p class="page-lede">A plugin for any coding agent (Claude Code, Cortex Code, Kiro): agents do the work, skills tell them how, and hooks enforce the rules.</p>
        <ul class="stats" aria-label="What ships">
          <li><span class="stats-value">{{agents}}</span> agents</li>
          <li><span class="stats-value">{{skills}}</span> skills</li>
          <li><span class="stats-value">{{hooks}}</span> hook scripts</li>
        </ul>
      </div>
      <div class="card install" data-install>
        <div class="install-bar">
          <div class="install-tablist" role="group" aria-label="Install or uninstall">
            <button type="button" class="install-tab install-mode" data-mode-choice="install" aria-pressed="true">Install</button>
            <button type="button" class="install-tab install-mode" data-mode-choice="uninstall" aria-pressed="false">Uninstall</button>
          </div>
          <div class="install-tablist" role="tablist" aria-label="Install target">
            <button type="button" class="install-tab" role="tab" id="install-tab-claude" data-install-target="claude" aria-controls="install-panel-claude" aria-selected="true" tabindex="0">Claude Code</button>
            <button type="button" class="install-tab" role="tab" id="install-tab-cortex" data-install-target="cortex" aria-controls="install-panel-cortex" aria-selected="false" tabindex="-1">Cortex Code</button>
            <button type="button" class="install-tab" role="tab" id="install-tab-kiro" data-install-target="kiro" aria-controls="install-panel-kiro" aria-selected="false" tabindex="-1">Kiro</button>
          </div>
        </div>
        <div class="install-panel" role="tabpanel" id="install-panel-claude" aria-labelledby="install-tab-claude">
          <code class="install-command" data-mode="install">[[@install-command claude]]</code>
          <button type="button" class="install-copy" data-mode="install" data-copy="[[@install-copy claude]]">Copy</button>
          <p class="install-note" data-mode="install">Then restart Claude Code or run <code>/reload-plugins</code>, and <code>/harness:init</code> once per project.</p>
          <code class="install-command" data-mode="uninstall" hidden>[[@install-command claude-off]]</code>
          <button type="button" class="install-copy" data-mode="uninstall" hidden data-copy="[[@install-copy claude-off]]">Copy</button>
          <p class="install-note" data-mode="uninstall" hidden>Restart Claude Code or run <code>/reload-plugins</code>. Each project keeps its state in <code>~/.local/state/harness/&lt;project&gt;/</code>, throwaway files in <code>/tmp/harness/&lt;project&gt;/</code> and its AGENTS.md; delete the state by hand if you want it gone.</p>
        </div>
        <div class="install-panel" role="tabpanel" id="install-panel-cortex" aria-labelledby="install-tab-cortex" hidden>
          <code class="install-command" data-mode="install">[[@install-command cortex]]</code>
          <button type="button" class="install-copy" data-mode="install" data-copy="[[@install-copy cortex]]">Copy</button>
          <p class="install-note" data-mode="install">Run it again to update; the Uninstall toggle shows the removal commands.</p>
          <p class="install-note" data-mode="install">Below, <span class="install-mark is-off">struck</span> parts are not ported to Cortex and <span class="install-mark is-partial">dotted</span> ones only partly.</p>
          <code class="install-command" data-mode="uninstall" hidden>[[@install-command cortex-off]]</code>
          <button type="button" class="install-copy" data-mode="uninstall" hidden data-copy="[[@install-copy cortex-off]]">Copy</button>
          <p class="install-note" data-mode="uninstall" hidden>The first part removes the plugin and the second removes a port install; either may report nothing to remove.</p>
          <p class="install-note" data-mode="uninstall" hidden>If a reinstall says the plugin path already exists, a folder was left behind: look for a harness folder in <code>~/.snowflake/cortex/plugins/</code>, move it away, then install again.</p>
        </div>
        <div class="install-panel" role="tabpanel" id="install-panel-kiro" aria-labelledby="install-tab-kiro" hidden>
          <code class="install-command" data-mode="install">[[@install-command kiro]]</code>
          <button type="button" class="install-copy" data-mode="install" data-copy="[[@install-copy kiro]]">Copy</button>
          <p class="install-note" data-mode="install">Run it again to update; add <code>--uninstall</code> after <code>kiro</code> to remove it.</p>
          <p class="install-note" data-mode="install">Below, <span class="install-mark is-off">struck</span> parts are not ported to Kiro and <span class="install-mark is-partial">dotted</span> ones only partly.</p>
          <code class="install-command" data-mode="uninstall" hidden>[[@install-command kiro-off]]</code>
          <button type="button" class="install-copy" data-mode="uninstall" hidden data-copy="[[@install-copy kiro-off]]">Copy</button>
          <p class="install-note" data-mode="uninstall" hidden>This removes only the files the installer wrote (listed in <code>~/.kiro/harness-port.json</code>) and the harness- entries in the crew hooks; your own agents, skills and hooks stay. The last part deletes the clone.</p>
        </div>
        <p class="install-note">The agent band above the prompt is a separate plugin: <a href="band.html">see its page</a>.</p>
      </div>
    </header>

    <main class="page-main">
      <div class="core" data-core>
        <section class="card binds" aria-labelledby="binds-title">
          <h2 class="binds-title" id="binds-title">How hard each part binds</h2>
          <p class="binds-intro">A level is how firmly a rule holds, from a hard stop at the top to written advice at the bottom.</p>
          <p class="binds-intro">Hooks enforce the top four levels. A reminder never stops a call; advice is up to the model.</p>
          <p class="pyramid-axis" aria-hidden="true"><span>Hardest on top</span><span>Parts</span></p>
          <div class="pyramid-box" data-pyramid>
            [[@pyramid]]
          </div>
        </section>

        <section class="parts" aria-labelledby="parts-title">
          <h2 class="visually-hidden" id="parts-title">Agents, skills and hooks</h2>
          <div class="panels" data-panels>
            [[@panels]]
          </div>
        </section>
      </div>

        <section class="card wire" aria-labelledby="wire-title">
          <h2 class="wire-title" id="wire-title">How it connects</h2>
          <p class="wire-intro">The main session spawns agents. Agents preload skills. Hooks inject text and check calls. Click a box to follow its links; click it again or press Escape to clear. Skill-to-skill pointers are off until you turn them on or pick a skill.</p>
          [[@diagram]]
        </section>
    </main>
  </div>

  <script defer src="script.js?v={{script_hash}}"></script>
  <script>
    (() => {
      const root = document.querySelector("[data-wire]");
      if (!root) return;
      const edges = [...root.querySelectorAll("[data-wire-edge]")];
      const nodes = [...root.querySelectorAll("[data-wire-node]")];
      const toggles = [...root.querySelectorAll("[data-wire-kind]")];
      const status = root.querySelector("[data-wire-status]");
      const visibleKinds = new Set(toggles.filter((toggle) => toggle.getAttribute("aria-pressed") === "true").map((toggle) => toggle.dataset.wireKind));
      let selected = null;

      const touches = (edge) => edge.dataset.wireSource === selected || edge.dataset.wireTarget === selected;

      const render = () => {
        const linkedNodes = new Set();
        let linkCount = 0;
        for (const edge of edges) {
          const isLinked = selected !== null && touches(edge);
          const isShown = visibleKinds.has(edge.dataset.wireEdge) || isLinked;
          edge.classList.toggle("is-off", !isShown);
          edge.classList.toggle("is-linked", isLinked);
          edge.classList.toggle("is-dim", selected !== null && !isLinked);
          if (isLinked) {
            linkCount += 1;
            linkedNodes.add(edge.dataset.wireSource);
            linkedNodes.add(edge.dataset.wireTarget);
          }
        }
        for (const node of nodes) {
          const key = node.dataset.wireNode;
          node.classList.toggle("is-dim", selected !== null && !linkedNodes.has(key) && key !== selected);
          node.setAttribute("aria-pressed", String(key === selected));
        }
        status.textContent = selected === null ? "" : `${selected.split(":")[1]}: ${linkCount} links, ${linkedNodes.size - 1} linked parts.`;
      };

      const choose = (key) => {
        selected = selected === key ? null : key;
        render();
      };

      for (const node of nodes) {
        node.addEventListener("click", () => choose(node.dataset.wireNode));
        node.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;
          event.preventDefault();
          choose(node.dataset.wireNode);
        });
      }
      for (const toggle of toggles) {
        toggle.addEventListener("click", () => {
          const kind = toggle.dataset.wireKind;
          if (visibleKinds.has(kind)) visibleKinds.delete(kind);
          else visibleKinds.add(kind);
          toggle.setAttribute("aria-pressed", String(visibleKinds.has(kind)));
          render();
        });
      }
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || selected === null) return;
        selected = null;
        render();
      });
      render();
    })();
  </script>
</body>
</html>
