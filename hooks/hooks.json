{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" ] || exit 0; uv run --script \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" ] || exit 0; uv run --script \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" SubagentStart",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" ] || exit 0; uv run --script \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task|Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" ] || exit 0; uv run --script \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" ] || exit 0; uv run --script \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" ] || exit 0; uv run --script \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" SubagentStop",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" ] || exit 0; uv run --script \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
